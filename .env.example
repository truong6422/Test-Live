# Sao chép thành .env rồi đổi TẤT CẢ giá trị "doi-..." trước khi chạy.
# Tạo chuỗi ngẫu nhiên:  openssl rand -hex 32

# --- PostgreSQL ---
POSTGRES_USER=sep
POSTGRES_PASSWORD=doi-mat-khau-postgres
POSTGRES_DB=sep

# --- Quản trị ---
# Mật khẩu đăng nhập dashboard (>= 8 ký tự)
ADMIN_PASSWORD=doi-mat-khau-admin
# Khoá ký cookie phiên (>= 32 ký tự)
SESSION_SECRET=doi-chuoi-ngau-nhien-it-nhat-32-ky-tu-xxxxxxxx
# Khoá cho overlay OBS: /overlay/?key=<OVERLAY_KEY> (>= 8 ký tự)
OVERLAY_KEY=doi-khoa-overlay
# true khi truy cập qua HTTPS
COOKIE_SECURE=false

# --- TikTok LIVE (tuỳ chọn) ---
# Để trống: kết nối bằng tay trong dashboard. Có giá trị: tự kết nối khi khởi động.
TIKTOK_USERNAME=
# API key sign server (Euler Stream) nếu cần. Chỉ dùng ở server.
TIKTOK_SIGN_API_KEY=

# --- Khác ---
HISTORY_RETENTION_DAYS=30
LOG_LEVEL=info

# --- Chạy local không Docker (bun run local / start / dev:server) ---
# Docker bỏ qua các dòng này (compose tự đặt HOST, PORT, STORE, DATABASE_URL).
HOST=127.0.0.1
# Giữ 3000 khi dùng dev:overlay / dev:admin (Vite proxy tới 127.0.0.1:3000).
PORT=3000
# memory = không cần Postgres (mất dữ liệu khi tắt). postgres = cần DATABASE_URL bên dưới.
STORE=memory
# DATABASE_URL=postgres://sep:doi-mat-khau-postgres@127.0.0.1:5432/sep

# --- Chỉ dùng cho Docker ---
# Nginx lắng nghe ở đâu. 127.0.0.1 = chỉ máy này (OBS cùng máy). 0.0.0.0 = mở ra mạng LAN.
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=8080
